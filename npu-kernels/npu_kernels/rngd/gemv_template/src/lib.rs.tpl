//! RNGD weight-streaming GEMV generated for ROWS=${ROWS} (padded ${ROWS_P}), COLS=${H}: y = W @ x, bf16.
//! Generated by opt_prime.moe_offload.kernels.rngd_opt.gemv - edit the template, not this file.
//! Rows are processed in ${NC} chunk(s) of F=${F}: 2 clusters x (${A} row groups x ${NH32} column blocks) slices,
//! each ${R} rows x 32 columns; the weight of chunk c+1 streams while chunk c computes (same scheme as the expert and
//! attention-projection GEMVs of the RNGD layer engine).
#![expect(clippy::type_complexity)]
#![feature(proc_macro_hygiene, stmt_expr_attributes)]
#![feature(register_tool)]
#![register_tool(furiosa_opt)]

pub mod axes {
    use furiosa_opt_std::prelude::*;
    axes![H = ${H}, F = ${F}, NC = ${NC}];
    pub type Chip = m![1];
}

use furiosa_opt_std::prelude::*;
pub use axes::{Chip, F, H, NC};

pub type GC = m![F / ${FH}];
pub type GS = m![F / ${R} % ${A}, H / 32];
pub type GSO = m![F / ${R} % ${A}, 1 # ${NH32}];
pub type GElem = m![F / 8 % ${R8}, H / 4 % 8, F % 8, H % 4];
/// HBM layout of W: chunk-major, each chunk in the slice order above
pub type WT = m![NC, F / ${R}, H / 32, F / 8 % ${R8}, H / 4 % 8, F % 8, H % 4];

pub fn gemv_g(
    device: &mut Device,
    w: &DmTensor<bf16, Chip, GC, GS, GElem>,
    x_trf: &TrfTensor<bf16, Chip, GC, GS, m![1], m![H % 32]>,
) -> DmTensor<bf16, Chip, GC, GSO, m![F % ${R}]> {
    device
        .main
        .begin(w.view())
        .fetch::<m![F / 8 % ${R8}, H / 4 % 8, F / 4 % 2], m![F % 4, H % 4]>()
        .collect::<m![F / 8 % ${R8}, H / 4 % 8, F / 4 % 2], m![F % 4, H % 4]>()
        .contract_outer::<m![F / 8 % ${R8}, H / 4 % 8], m![F % 8, H % 4], _, _, _>(x_trf)
        .contract_packet::<m![F % 8]>()
        .contract_time::<m![F / 8 % ${R8}]>()
        .contract_lane::<m![F / 8 % ${R8}], m![F % 8]>(LaneMode::Sequential)
        .vector_init()
        .vector_inter_slice_reduce::<GSO, m![F / 8 % ${R8}]>(InterSliceReduceOpF32::Add)
        .vector_final()
        .cast::<bf16, m![F % 8 # 16]>()
        .commit_trim::<m![F % 8]>()
        .commit()
}

pub fn load_x(device: &mut Device, x: &HbmTensor<bf16, Chip, m![H]>) -> TrfTensor<bf16, Chip, GC, GS, m![1], m![H % 32]> {
    let x: DmTensor<bf16, Chip, GC, GS, m![H % 32]> = x.to_dm(&mut device.tdma);
    device.sub.begin(x.view()).fetch::<m![1], m![H % 32]>().collect::<m![H / 16 % 2], m![H % 16]>().to_trf()
}

#[device(chip = 1, pe = 8)]
pub fn gemv_k(
    device: &mut Device,
    x: &HbmTensor<bf16, Chip, m![H]>,
    w: &HbmTensor<bf16, Chip, WT>,
    out: &mut HbmTensor<bf16, Chip, m![NC, F]>,
) {
    let x_trf = load_x(device, x);
${CHUNKS}
