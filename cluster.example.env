# Site-specific settings for moe_offload. Copy to cluster.local.env (untracked) and fill in.
# Variables already set in the environment take precedence over this file.

# Required by the gateway (moe-offload gateway / moe_offload.llmd.gateway) and the selftest:
# path to an rngd_llmd checkout; its gateway/ package (registry, kv_events, epp) is imported.
RNGD_LLMD=/path/to/rngd_llmd

# Optional: default for `moe-offload worker --gateway` (register with this gateway).
LLMD_GATEWAY_URL=http://<gateway-host>:<port>
